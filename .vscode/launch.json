{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Website (Flask, opens the browser)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. Train models and build the data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Terminal estimator (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python/3_estimate_cli.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Console app (Java)",
      "type": "java",
      "request": "launch",
      "mainClass": "CarbonFootprintApp",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "5. API tests (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
